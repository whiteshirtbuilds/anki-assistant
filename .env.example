# Lokale Speicherorte. Werte mit Leerzeichen bitte in Anführungszeichen setzen.
ANKI_ASSISTANT_LOCALAI_ROOT="~/Library/Application Support/Anki-Lernassistent/LocalAI"
ANKI_ASSISTANT_ANKI_MEDIA="~/Library/Application Support/Anki2/User 1/collection.media"
ANKI_ASSISTANT_MLX_VLM=""
ANKI_ASSISTANT_VOICE_BRIDGE=""

# Öffentliche Standardkennungen. Eigene Werte bleiben ausschließlich in .env.
ANKI_ASSISTANT_BUNDLE_ID="app.whiteshirtbuilds.ankiassistant"
ANKI_ASSISTANT_KEYCHAIN_SERVICE="app.whiteshirtbuilds.ankiassistant.gemini"
ANKI_ASSISTANT_PLUGIN_AUTHOR="whiteshirtbuilds"
